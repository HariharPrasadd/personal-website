{
  "name": "harihar-excalidraw",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && esbuild worker/index.ts --bundle --format=esm --outfile=dist/_worker.js",
    "check": "tsc -b --pretty false && esbuild worker/index.ts --bundle --format=esm --outfile=.wrangler/worker-check.js",
    "deploy": "npm run build && wrangler pages deploy dist --project-name harihar-drawings --branch main",
    "db:migrate:local": "wrangler d1 migrations apply EXCALIDRAW_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply EXCALIDRAW_DB --remote"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "mermaid": "11.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "wrangler": "^4.72.0"
  }
}
